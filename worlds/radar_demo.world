<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>-8.0 0.0 5.0 0.0 0.5 0.0</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Ground plane - ignored by radar -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>500 500 0.01</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.005 0 0 0</pose>
          <geometry>
            <box><size>500 500 0.01</size></box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
            </script>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <rmagine_ignore/>
    </model>

    <!-- ============================================ -->
    <!-- Concrete Wall: 5m ahead, strong reflection   -->
    <!-- ============================================ -->
    <model name="concrete_wall">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.2 8.0 3.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.5</diffuse>
            <specular>5000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.2 8.0 3.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- Metal Pillar: 3m ahead-left, very strong     -->
    <!-- ============================================ -->
    <model name="metal_pillar">
      <static>true</static>
      <pose>3 2 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.15</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.4 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>1.0</diffuse>
            <specular>10000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.15</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- Glass Wall: 4m ahead-right, transparent      -->
    <!-- Radar passes through partially               -->
    <!-- ============================================ -->
    <model name="glass_wall">
      <static>true</static>
      <pose>4 -2 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 3.0 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.8 0.3</ambient>
          </material>
          <radarays_material>
            <velocity>0.2</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.0</diffuse>
            <specular>30.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.1 3.0 2.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- Box behind glass: only visible through glass -->
    <!-- ============================================ -->
    <model name="box_behind_glass">
      <static>true</static>
      <pose>7 -2 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.5</diffuse>
            <specular>3000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>1.0 1.0 1.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- Wood Box: 6m ahead, weak reflection          -->
    <!-- ============================================ -->
    <model name="wood_box">
      <static>true</static>
      <pose>6 1 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>0.5</ambient>
            <diffuse>0.3</diffuse>
            <specular>50.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 1.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- Person-sized cylinder: 4m ahead              -->
    <!-- ============================================ -->
    <model name="person">
      <static>true</static>
      <pose>4 0 0.9 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.25</radius><length>1.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.5 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>0.8</ambient>
            <diffuse>0.8</diffuse>
            <specular>200.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.25</radius><length>1.8</length></cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================ -->
    <!-- Reflector wall for multi-path ghost          -->
    <!-- Two walls at 90° creating corner reflector   -->
    <!-- ============================================ -->
    <model name="corner_wall_1">
      <static>true</static>
      <pose>3 -4 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.15 3.0 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.5</diffuse>
            <specular>8000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.15 3.0 2.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="corner_wall_2">
      <static>true</static>
      <pose>4.5 -5.5 1.0 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.15 3.0 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.5</diffuse>
            <specular>8000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.15 3.0 2.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Rmagine Map Plugins -->
    <plugin name='rmagine_embree_map' filename='librmagine_embree_map_gzplugin.so'>
      <update>
        <delta_trans>1.0</delta_trans>
        <delta_rot>1.0</delta_rot>
        <delta_scale>1.0</delta_scale>
        <rate_limit>1</rate_limit>
      </update>
    </plugin>
    <plugin name='rmagine_optix_map' filename='librmagine_optix_map_gzplugin.so'>
      <update>
        <delta_trans>1.0</delta_trans>
        <delta_rot>1.0</delta_rot>
        <delta_scale>1.0</delta_scale>
        <rate_limit>1</rate_limit>
      </update>
    </plugin>

    <light type="point" name="my_light">
      <pose>0 0 30 0 0 0</pose>
      <diffuse>.8 .8 .8 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <attenuation>
        <range>200</range>
        <linear>0.02</linear>
        <constant>0.1</constant>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
  </world>
</sdf>
