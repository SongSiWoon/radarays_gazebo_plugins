<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>-8.0 0.0 5.0 0.0 0.5 0.0</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Ground plane - ignored by rmagine ray tracing -->
    <model name="plane1_model">
      <link name="body">
        <collision name="geom_1">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual_1">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>Gazebo/Grey</script>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <static>true</static>
      <rmagine_ignore/>
    </model>

    <!-- Wall: 5m ahead, glass-like (partially transparent) -->
    <model name="wall_front">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.2 6.0 4.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.8 0.5</ambient>
          </material>
          <radarays_material>
            <velocity>0.8</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.5</diffuse>
            <specular>5000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>0.2 6.0 4.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Box: 10m ahead, 2m right -->
    <model name="box_right">
      <static>true</static>
      <pose>10 -2 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.5</diffuse>
            <specular>100.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <box><size>1.0 1.0 1.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Cylinder: 7m ahead, 2m left -->
    <model name="cylinder_left">
      <static>true</static>
      <pose>7 2 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>1.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
          </material>
          <radarays_material>
            <velocity>0.0</velocity>
            <ambient>1.0</ambient>
            <diffuse>0.3</diffuse>
            <specular>1000.0</specular>
          </radarays_material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.5</radius><length>1.5</length></cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Embree Map Plugin -->
    <plugin name='rmagine_embree_map' filename='librmagine_embree_map_gzplugin.so'>
      <update>
        <delta_trans>0.001</delta_trans>
        <delta_rot>0.001</delta_rot>
        <delta_scale>0.001</delta_scale>
        <rate_limit>200</rate_limit>
      </update>
    </plugin>

    <!-- OptiX Map Plugin -->
    <plugin name='rmagine_optix_map' filename='librmagine_optix_map_gzplugin.so'>
      <update>
        <delta_trans>0.001</delta_trans>
        <delta_rot>0.001</delta_rot>
        <delta_scale>0.001</delta_scale>
        <rate_limit>200</rate_limit>
      </update>
    </plugin>

    <light type="point" name="my_light">
      <pose>0 0 30 0 0 0</pose>
      <diffuse>.8 .8 .8 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <attenuation>
        <range>200</range>
        <linear>0.02</linear>
        <constant>0.1</constant>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
  </world>
</sdf>
